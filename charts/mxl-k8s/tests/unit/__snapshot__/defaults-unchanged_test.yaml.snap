                  name: metrics
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: probe
                initialDelaySeconds: 2
              resources:
                limits: {}
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
