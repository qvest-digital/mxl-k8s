                "color": "green",
                "value": 0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_payload_slice_size_bytes{node=~\"$node\",flow_id=~\"$flow\",payload_buffer_index=\"0\"}",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
