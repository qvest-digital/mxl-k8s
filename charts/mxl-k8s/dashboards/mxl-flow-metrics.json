    {
      "id": 11,
      "title": "Video Head Index Rate (frames/s)",
      "description": "Grains per second written to a discrete flow, as a one-minute rate over the head index. A stable value at the flow's declared grain rate is the healthy reading. Separate from audio because a sample rate and a frame rate on one axis flatten the frame rate to a line at zero.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mxl_flow_head_index_grains{node=~\"$node\",flow_id=~\"$flow\"}[1m]) * on(flow_id, domain, node) group_left() (mxl_flow_metadata{flow_data_type=~\"[Vv]ideo\"})",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Audio Head Index Rate (samples/s)",
