          "expr": "rate(mxl_flow_head_index_grains{node=~\"$node\",flow_id=~\"$flow\"}[1m]) * on(flow_id, domain, node) group_left() (mxl_flow_metadata{flow_data_type=~\"[Aa]udio\"})",
          "legendFormat": "{{node}} / {{flow_id}}"
