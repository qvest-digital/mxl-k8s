    {
      "id": 22,
      "title": "Domain Filesystem Utilization",
      "description": "Used share of the filesystem backing the domain, as used / (used + available). Flows reserve their buffers up front, so the value is flat while they run rather than growing with uptime. At 100% no further flow can be created, which makes this the panel to read before changing a buffer size.",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 76
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_domain_size_bytes{node=~\"$node\"} / ignoring(fs_path) (mxl_domain_size_bytes{node=~\"$node\"} + ignoring(fs_path) mxl_domain_fs_space_available_bytes{node=~\"$node\"}) * 100",
          "legendFormat": "{{node}}"
        }
      ]
    },
