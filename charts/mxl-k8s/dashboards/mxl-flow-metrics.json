  "panels": [
    {
      "id": 100,
      "title": "Status & Health",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Active Flows",
      "description": "Whether a flow is currently being written. The exporter compares the head index at each scrape against the previous one: advanced means data is flowing (ACTIVE), unchanged means the flow is frozen (STALLED). A flow can be present and stalled at once, which is what a writer that died while its flow directory survived looks like.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STALLED",
                  "color": "red"
                },
                "1": {
                  "text": "ACTIVE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_active{node=~\"$node\",flow_id=~\"$flow\"}",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Flows Present",
      "description": "Whether the flow directory (*.mxl-flow) still exists in the node's domain. PRESENT means the directory is there, MISSING that it is gone. A departed flow keeps its series, at 0, until --flow-lifetime expires, so a short outage stays visible in the time range instead of leaving a gap. Present says nothing about data flowing; Active Flows does.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MISSING",
                  "color": "red"
                },
                "1": {
                  "text": "PRESENT",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_present{node=~\"$node\",flow_id=~\"$flow\"}",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Flows per Domain",
      "description": "Flows the exporter found in the node's domain. A domain is a directory holding one or more *.mxl-flow subdirectories, shared by every pod on the node, so this counts the node's flows rather than any one workload's.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_domain_num_flows{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Domain Shared Memory Used",
      "description": "Combined on-disk size of the domain's flow data. A flow reserves its full ring buffer when it is created and releases it when it is torn down, so the value is flat while a flow runs rather than growing with uptime.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_domain_size_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Domain Filesystem Available",
      "description": "Free space on the filesystem backing the domain. On a tmpfs-backed domain this is RAM. At zero no further flow can be created and running flows can fail, so the useful reading is the headroom rather than the absolute number.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 10485760
              },
              {
                "color": "green",
                "value": 52428800
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_domain_fs_space_available_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 101,
      "title": "End-to-End Flow Status",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 17,
      "title": "Producer Flows Active",
      "description": "Flows being written on the node that holds their origin. mxl_flow_location_info carries phase Origin exactly on the node the writer runs on, so joining the domain metrics against it on (flow_id, node) counts producers without a workload having to label itself. Spans every node rather than the Node filter above, because end-to-end health is a property of the system.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((mxl_flow_active == 1) and on(flow_id, node) (mxl_flow_location_info{phase=\"Origin\"})) or vector(0)",
          "legendFormat": "Producer"
        }
      ]
    },
    {
      "id": 18,
      "title": "Consumer Flows Active",
      "description": "Flows arriving into a node's domain from the fabric, counted where mxl_flow_location_info reports phase Ready or Mirroring. This measures arrival into the local domain, not what a reader does with it afterwards. Below Producer Flows Active means at least one flow is not reaching its consumer.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((mxl_flow_active == 1) and on(flow_id, node) (mxl_flow_location_info{phase=~\"Ready|Mirroring\"})) or vector(0)",
          "legendFormat": "Consumer"
        }
      ]
    },
    {
      "id": 19,
      "title": "End-to-End Active",
      "description": "Flows active at their origin and also materialised Ready on some node. The gap against the producer and consumer counts is where a flow is live on one side only. Spans every node, because end-to-end health is measured system-wide.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(((mxl_flow_active == 1) and on(flow_id, node) (mxl_flow_location_info{phase=\"Origin\"})) and on(flow_id) (mxl_flow_location_info{phase=\"Ready\"})) or vector(0)",
          "legendFormat": "E2E"
        }
      ]
    },
    {
      "id": 102,
      "title": "Flow State History",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "title": "Active Timeline",
      "description": "ACTIVE/STALLED state of every flow over the selected range. Where the Active Flows stat shows the current value, this shows when a flow stopped and how long it stayed stopped.",
      "type": "state-timeline",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "rowHeight": 0.9,
        "showValue": "auto",
        "alignValue": "left",
        "mergeValues": true,
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STALLED",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ACTIVE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_active{node=~\"$node\",flow_id=~\"$flow\"}",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "Present Timeline",
      "description": "PRESENT/MISSING state of every flow over the selected range. A flow whose directory is gone keeps its series until --flow-lifetime expires, so a restart reads as a bounded gap rather than a series that disappears.",
      "type": "state-timeline",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "rowHeight": 0.9,
        "showValue": "auto",
        "alignValue": "left",
        "mergeValues": true,
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MISSING",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PRESENT",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_present{node=~\"$node\",flow_id=~\"$flow\"}",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 103,
      "title": "Latency",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Video Flow Latency (ms)",
      "description": "How far a discrete flow's head index sits behind where the MXL clock puts it, converted to milliseconds through the flow's own grain rate. One grain of lag is normal, and the grain duration is the unit to read this in. Only active flows are shown.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(mxl_flow_latency_grains{node=~\"$node\",flow_id=~\"$flow\"} / mxl_flow_rate_num{node=~\"$node\",flow_id=~\"$flow\"} * mxl_flow_rate_den{node=~\"$node\",flow_id=~\"$flow\"} * 1000) * on(flow_id, domain, node) group_left(flow_data_type) (mxl_flow_metadata{flow_data_type=~\"[Vv]ideo\"}) * on(flow_id, domain, node) group_left() (mxl_flow_active == 1)",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Audio Flow Latency (ms)",
      "description": "How far a continuous flow's head index sits behind where the MXL clock puts it, converted to milliseconds through the flow's own grain rate. Only active flows are shown.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(mxl_flow_latency_grains{node=~\"$node\",flow_id=~\"$flow\"} / mxl_flow_rate_num{node=~\"$node\",flow_id=~\"$flow\"} * mxl_flow_rate_den{node=~\"$node\",flow_id=~\"$flow\"} * 1000) * on(flow_id, domain, node) group_left(flow_data_type) (mxl_flow_metadata{flow_data_type=~\"[Aa]udio\"}) * on(flow_id, domain, node) group_left() (mxl_flow_active == 1)",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 104,
      "title": "Frame Rate",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false,
      "panels": []
