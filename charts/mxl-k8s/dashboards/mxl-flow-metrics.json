  "title": "MXL Flow Metrics",
  "uid": "mxl-flow-metrics",
  "tags": [
    "mxl",
    "flows",
    "operator-managed"
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(mxl_flow_active, node)",
        "query": {
          "query": "label_values(mxl_flow_active, node)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
