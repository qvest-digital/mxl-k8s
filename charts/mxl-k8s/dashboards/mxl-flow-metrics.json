      "panels": []
    },
    {
      "id": 7,
      "title": "Last Write Age (ms)",
      "description": "Time since the last write to the flow, measured on the MXL clock at scrape time. A running flow holds this at about one grain duration. The exporter computes the age itself: subtracting the scrape-time timestamp from the query evaluation clock instead reports roughly half a scrape interval.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_last_write_age_seconds{node=~\"$node\",flow_id=~\"$flow\"} * 1000",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 107,
      "title": "Buffer & Memory Configuration",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 71
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "title": "Ring Buffer Depth (ms)",
      "description": "How much content a flow's ring buffer holds, as grain count times grain duration. This is the lag a reader may accumulate before the writer overwrites grains it has not read yet. Fixed when the flow is created.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mxl_flow_ring_buffer_size_grains{node=~\"$node\",flow_id=~\"$flow\"} / mxl_flow_rate_num{node=~\"$node\",flow_id=~\"$flow\"} * mxl_flow_rate_den{node=~\"$node\",flow_id=~\"$flow\"} * 1000",
          "legendFormat": "{{node}} / {{flow_id}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Payload Slice Size",
      "description": "Size of one payload buffer slice for the flow's first plane, in bytes. Together with the ring buffer depth it gives the flow's memory footprint. Fixed when the flow is created.",
