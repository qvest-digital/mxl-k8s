        "hide": 0
      },
      {
        "name": "flow",
        "label": "Flow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(mxl_flow_active, flow_id)",
        "query": {
          "query": "label_values(mxl_flow_active, flow_id)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "refresh": 2,
        "regex": "",
